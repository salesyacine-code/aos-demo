# Environment variables for SOA Project - Group VII
NODE_ENV=development

# Infrastructure
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025

# Service Ports (Host / Container)
PORT_GATEWAY=8000
PORT_STUDENT_SERVICE=8001
PORT_REQUEST_SERVICE=8002
PORT_DOCUMENT_SERVICE=8003
PORT_NOTIFICATION_SERVICE=8004
PORT_FRONTEND=3000

# Base URLs (Internal)
STUDENT_SERVICE_URL=http://student-service:8001
REQUEST_SERVICE_URL=http://request-service:8002
DOCUMENT_SERVICE_URL=http://document-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004
GATEWAY_URL=http://gateway:8000

